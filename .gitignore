# 生成物与大文件：不入仓
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# 任务运行产物：证据链小文件入仓（docs/ 下 csv/jsonl/audit），以下为可再生成的大文件
tasks/*/run/
tasks/*/profile/
profile/
runs/
outputs/

# 断点与审计承诺的例外（interaction-protocol §2/§7：state.json 续跑、compact 可审计、profile 摘要入仓）
!tasks/*/run/state.json
!tasks/*/run/compact-*.md
!tasks/*/profile/**/summary.json

# 全局预算账本（套餐级，跨任务；ADR-006）
run-global/

# 模板目录占位（run/ 被忽略但模板需要目录存在）
!tasks/_template/run/.gitkeep
*.ncu-rep
*.npz
*.npy
*.pt
*.csv.tmp

# msprof 输出
mindstudio_profiler_output/
PROF_*/

# 本地环境与密钥：绝不入仓
.env
agent-config/local*.yaml
*.apikey

# 编辑器
.vscode/
.idea/
.DS_Store

# 重资产：cann/ops-* 生产代码 vendor 层（474M，ADR-009 修订：不入 git 历史）
# 重建：python tools/sync_assets.py --bootstrap-cann-ops（拉取+剥tests+建索引，约几分钟）
third_party/cann-ops/
