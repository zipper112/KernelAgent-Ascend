# 生成物与大文件：不入仓
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# 任务运行产物：排除"目录下所有内容"而非目录本身（Git 规则：对已排除目录内的 ! 再包含永不生效——自审批次修复）
tasks/*/run/**
tasks/*/profile/**
tasks/_template/run/**
tasks/_template/profile/**
profile/**
runs/
outputs/

# 断点与审计承诺的例外（interaction-protocol §2/§7：state.json 续跑、compact 可审计、profile 摘要入仓）
# run/lock 不再包含（v0.2：瞬时运行态，含 host/last_seen，入仓易误导断点判断）
!tasks/*/run/state.json
!tasks/*/run/usage.jsonl
!tasks/*/run/compact-*.md
!tasks/*/run/round-*.md
# profile 例外（顺序关键，Git 再包含语义实测）：先排除/** → 放行目录遍历 → 只放行 summary.json
tasks/*/profile/**
!tasks/*/profile/**/
!tasks/*/profile/**/summary.json
!tasks/_template/run/.gitkeep

# 全局预算账本（套餐级，跨任务；ADR-006）
run-global/

*.ncu-rep
*.npz
*.npy
*.pt
*.csv.tmp

# msprof 输出
mindstudio_profiler_output/
PROF_*/

# 本地环境与密钥：绝不入仓
.env
agent-config/local*.yaml
*.apikey

# 编辑器
.vscode/
.idea/
.DS_Store

# 重资产：cann/ops-* 生产代码 vendor 层（474M，ADR-009 修订：不入 git 历史）
# 重建：python tools/sync_assets.py --bootstrap-cann-ops（拉取+剥tests+建索引，约几分钟）
third_party/cann-ops/

# 密钥与凭据（永不入仓）
*.id
*.pem
*.key
secrets.json
